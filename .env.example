# M4 CopyDesk — segreti locali. Copia in .env (`m4desk init` lo fa con permessi 0600).
# .env è escluso da git. NON inserire MAI chiavi private di wallet o seed phrase: non servono.

# Opzionale: chiave GRATUITA Helius (piano Free, nessuna carta di credito). Lascia vuoto per RPC pubblico.
HELIUS_API_KEY=

# Opzionale: chiave GRATUITA Jupiter (portal developers.jup.ag). Vuoto = accesso keyless con limiti ridotti.
JUPITER_API_KEY=

# Token che protegge i pulsanti PAUSA/RIPRENDI/ARRESTA della dashboard (generato da `m4desk init`).
M4DESK_DASHBOARD_TOKEN=

# Notifiche push sul telefono (ntfy, gratuito). Il nome del topic è SEGRETO: chi lo conosce legge
# le notifiche. Generato da `m4desk init`; iscriviti allo stesso topic dall'app ntfy (iOS/Android).
NTFY_TOPIC=
